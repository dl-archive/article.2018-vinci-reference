% TITLE PAGE (1st Page)
\defbeamertemplate*{title page}{cgi}[1][]
{
	\center
	%
	\usebeamerfont{title}\usebeamercolor[fg]{title}
	\inserttitle\par
	%
	\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}
	\ifx\insertsubtitle\empty
	% do nothing
	\else
		\medskip\insertsubtitle\par
	\fi
	%
	\bigskip
	%
	\inserttitlegraphic\par
	%
	\usebeamerfont{author}\usebeamercolor[fg]{author}
	\ifx\insertauthor\empty
	% do nothing
	\else
		\bigskip\insertauthor\par
	\fi
	%
	\usebeamerfont{institute}\usebeamercolor[fg]{institute}
	\ifx\insertinstitute\empty
		% do nothing
	\else
		\smallskip\insertinstitute\par
	\fi
}


% FRAME TITLE (Header)
\defbeamertemplate*{frametitle}{cgi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, ht=8mm, dp=1mm, wd=\paperwidth]{frametitle}
		\usebeamerfont{frametitle}\insertframetitle{}
	\end{beamercolorbox}
	\nointerlineskip
	\vspace{-16mm}
	\begin{beamercolorbox}[right, rightskip=8mm, ht=16mm, dp=1mm, wd=\paperwidth]{}
		\pgfuseimage{cgi@logo}
	\end{beamercolorbox}
	\vspace{-2mm}
}


% FOOT LINE (Footer)
\defbeamertemplate*{footline}{cgi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, rightskip=8mm, dp=4mm, wd=\paperwidth]{footline}
		\insertpagenumber \quad \insertshorttitle 
		\hfill \insertauthor %\insertsubtitle~\ifx\insertsectionhead\empty\else\slash~\insertsectionhead\fi
		\hfill VINCI 2018 Växjö, Sweden \quad 2018-08-14%\DTMtoday
	\end{beamercolorbox}%
}

